---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <h1 class="visually-hidden">Arbeiten</h1>
  <ul class="project-list">
    {
      projects.map((project) => (
        <li>
          <a href={`/projekte/${project.id}/`}>
            {project.data.cover && <Image src={project.data.cover} alt="" widths={[640, 1280, 1920]} />}
            <h2>{project.data.title}</h2>
            <p>
              {project.data.client} · {project.data.year}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .project-list a {
    text-decoration: none;
  }

  h2 {
    font-size: var(--text-lg);
    margin: var(--space-3) 0 0;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
