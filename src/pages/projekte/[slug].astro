---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, client, year, roles, summary, cover } = project.data;
---

<BaseLayout title={title} description={summary}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        {[client, year, roles.join(', ')].filter(Boolean).join(' · ')}
      </p>
    </header>
    {cover && <Image src={cover} alt="" widths={[960, 1920, 2400]} />}
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    margin: var(--space-5) 0 var(--space-3);
  }

  .meta {
    color: var(--color-muted);
    margin: 0 0 var(--space-5);
  }

  .body {
    max-width: 40rem;
    margin-block: var(--space-5) var(--space-7);
  }
</style>
