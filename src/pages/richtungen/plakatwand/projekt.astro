---
import '@fontsource-variable/bricolage-grotesque/index.css';
import '../../../prototypes/plakatwand.css';
import PrototypeLayout from '../../../layouts/PrototypeLayout.astro';
import { caseStudy, projects, ratio } from '../../../prototypes/data';

const { project, role, sections, gallery } = caseStudy;
const next = projects[1];
const tones = ['paper', 'pink', 'acid', 'paper', 'ultra', 'pink'];
---

<PrototypeLayout title={`${project.title} · Plakatwand`}>
  <div class="wall-page">
    <header class="bar">
      <a href="/richtungen/plakatwand/" class="bar__name">Julian Schleiminger</a>
      <nav aria-label="Hauptnavigation">
        <a href="/richtungen/plakatwand/#arbeiten">Arbeiten</a>
        <a href="/richtungen/plakatwand/#kontakt">Kontakt</a>
      </nav>
    </header>

    <main class="case">
      <header class="poster poster--orange case-head">
        <h1>{project.title}</h1>
        <dl class="case-facts">
          <div><dt>Kunde</dt><dd>{project.client} (Platzhalter)</dd></div>
          <div><dt>Jahr</dt><dd>{project.year}</dd></div>
          <div><dt>Rolle</dt><dd>{role}</dd></div>
          <div><dt>Disziplinen</dt><dd>{project.disciplines.join(', ')}</dd></div>
        </dl>
      </header>

      <div class="case-notes">
        {
          sections.map((s) => (
            <section class="poster poster--paper">
              <h2>{s.heading}</h2>
              <p>{s.text}</p>
            </section>
          ))
        }
      </div>

      <ul class="case-gallery">
        {
          gallery.map((g, i) => (
            <li class={`poster poster--${tones[i]}`} style={`--w: ${g.format === '16:9' ? 2 : 1}`}>
              <span class="poster__image" style={`aspect-ratio: ${ratio(g.format)}`}>
                {g.video && (
                  <svg class="play" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 4.5v15l12.5-7.5z" />
                  </svg>
                )}
                <span class="ph-label">Platzhalter · {g.label} {g.format}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <a class="poster poster--ultra case-next" href="/richtungen/plakatwand/projekt/">
        <span>Nächstes Plakat</span>
        <strong>{next.title}</strong>
      </a>
    </main>
  </div>
</PrototypeLayout>

<style>
  .case {
    display: grid;
    gap: var(--gap);
    max-width: 96rem;
    margin: 0 auto;
    padding: calc(var(--bar) + 2rem) clamp(1rem, 4vw, 3rem) 4rem;
  }

  .case-head {
    min-height: 70vh;
    justify-content: space-between;
  }

  .case-head h1 {
    margin: 0;
    max-width: 12ch;
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: clamp(2rem, 7.5vw, 9rem);
    line-height: 0.85;
    text-transform: uppercase;
    hyphens: auto;
  }

  .case-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem var(--gap);
    margin: 2rem 0 0;
  }

  .case-facts dt {
    font-weight: 700;
  }

  .case-facts dd {
    margin: 0;
  }

  .case-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--gap);
  }

  .case-notes h2 {
    margin: 0 0 0.5rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: 2rem;
    text-transform: uppercase;
  }

  .case-notes p {
    margin: 0;
  }

  .case-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    grid-auto-flow: dense;
    align-items: start;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .case-gallery .poster {
    grid-column: span var(--w);
  }

  .case-gallery .poster__image {
    width: 100%;
    height: auto;
  }

  .case-next {
    gap: 0.5rem;
  }

  .case-next span {
    font-weight: 600;
  }

  .case-next strong {
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--acid);
  }

  @media (max-width: 760px) {
    .case-gallery .poster {
      grid-column: auto;
    }
  }
</style>
